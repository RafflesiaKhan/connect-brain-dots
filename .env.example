# ─── Database ────────────────────────────────────────────────────────────────
# Default: the local Postgres from `docker compose up -d`.
# For Neon (https://neon.tech), replace with the "pooled" connection string from
# your Neon dashboard, e.g. postgresql://user:password@ep-....neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cbd"

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google login (https://console.cloud.google.com/apis/credentials)
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: GitHub login
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional: email magic links via Resend (https://resend.com)
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Connect Brain Dots <onboarding@resend.dev>"

# Local development shortcut: sign in with just a name + email, no password.
# NEVER enable this in production.
AUTH_DEMO_LOGIN="true"

# ─── Encryption for user-provided API keys (falls back to AUTH_SECRET) ───────
ENCRYPTION_KEY=""

# ─── House AI keys (optional) ────────────────────────────────────────────────
# Used when a user has not entered their own key in Settings.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
XAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434/api"
# Let users enter their own Ollama URL in production. Only enable if you trust your users:
# the server will make requests to whatever address they type.
OLLAMA_ALLOW_CUSTOM_URL="false"

# Web research for models without built-in search (https://tavily.com, free tier)
TAVILY_API_KEY=""
